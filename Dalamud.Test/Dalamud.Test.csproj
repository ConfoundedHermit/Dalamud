<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.v3.assert" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dalamud\Dalamud.csproj" />
    </ItemGroup>

    <!-- Refresh native fixtures on every build so tests cannot silently use older DLLs. -->
    <ItemGroup>
        <None Include="..\bin\$(Configuration)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="Always" />
        <None Include="..\bin\$(Configuration)\cimplot.dll" Link="cimplot.dll" CopyToOutputDirectory="Always" />
        <None Include="..\bin\$(Configuration)\cimguizmo.dll" Link="cimguizmo.dll" CopyToOutputDirectory="Always" />
    </ItemGroup>

</Project>
